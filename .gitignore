node_modules/
package.json
package-lock.json
dist/
__pycache__/

# build/ is generated, but the dictionary, the flower art and the printable
# tag sheets are inputs to build.py - committing them keeps the build fast and
# reproducible (regenerating the marker dictionary alone takes ~90s).
build/*
!build/dictionary.json
!build/flowers.json
!build/papertrace-markers-A4.pdf
!build/papertrace-markers-Letter.pdf
!build/papertrace-canvas-A4.pdf
!build/papertrace-canvas-Letter.pdf

# transport artefact from the Claude session
papertrace-repo.tgz

# local venv used to run gen_*.py (reportlab/numpy/pillow)
.venv/
